DATABASE_URL=postgresql://bjx:bjx@localhost:5432/bjx_db
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_SECRETS_MANAGER
ACCESS_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_EMAIL=admin@bjx.com
ADMIN_PASSWORD=Admin1234

# ── Storage (Sprint 0) ───────────────────────────────────────────────────────
# STORAGE_BACKEND: "local" (default dev) | "r2" (prod Cloudflare R2)
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage_local
# R2 (solo si STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=bjx-atlas-prod
R2_PUBLIC_DOMAIN=
